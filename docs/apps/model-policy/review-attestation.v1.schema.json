{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://libre-ai.fr/schemas/model-policy-review-attestation.v1.schema.json",
  "title": "Libre AI Model Policy independent review attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewId",
    "phaseId",
    "gateId",
    "candidateCommit",
    "role",
    "reviewerRef",
    "verdict",
    "findings",
    "reportPath",
    "reportSha256",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.model-policy-review-attestation.v1" },
    "reviewId": {
      "type": "string",
      "pattern": "^MP-REV-[A-Z0-9][A-Z0-9-]{2,63}$"
    },
    "phaseId": { "type": "string", "pattern": "^MP-P[0-9]+$" },
    "gateId": { "type": "string", "pattern": "^MP-P[0-9]+-G[0-9]{2}$" },
    "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "role": {
      "enum": [
        "accessibility",
        "architecture",
        "business",
        "legal",
        "operations",
        "performance",
        "privacy",
        "security",
        "technical"
      ]
    },
    "reviewerRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "verdict": { "enum": ["approve", "approve_with_minor_reservations", "reject"] },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking", "major", "minor", "residual"],
      "properties": {
        "blocking": { "$ref": "#/$defs/findingList" },
        "major": { "$ref": "#/$defs/findingList" },
        "minor": { "$ref": "#/$defs/findingList" },
        "residual": { "$ref": "#/$defs/findingList" }
      }
    },
    "reportPath": {
      "type": "string",
      "pattern": "^docs/reviews/[A-Za-z0-9._/-]+\\.md$"
    },
    "reportSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  },
  "$defs": {
    "findingList": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
